// Prisma Schema for Codebase Copilot
// Supports both OSS and SaaS modes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication & User Management
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // For email/password auth
  image         String?
  role          UserRole  @default(USER)
  
  // SaaS Mode Fields
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  tickets       Ticket[]
  ticketReplies TicketReply[]
  apiKeys       ApiKey[]

  @@index([email])
  @@index([organizationId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// ============================================
// Organization Management (SaaS Mode)
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  
  // Subscription
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   Plan      @default(FREE)
  
  // Limits
  maxUsers       Int @default(5)
  maxAnalyses    Int @default(10)
  usedAnalyses   Int @default(0)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users     User[]
  analyses  Analysis[]

  @@index([slug])
  @@index([stripeCustomerId])
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ============================================
// API Key Management
// ============================================

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider   String // ibm, openai, anthropic, google
  key        String // Encrypted
  model      String?
  
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([provider])
}

// ============================================
// Codebase Analysis
// ============================================

model Analysis {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // SaaS Mode
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  // Analysis Details
  name        String
  mode        AnalysisMode
  sourceType  SourceType
  sourceUrl   String?
  
  // Results (stored as JSON)
  metadata    Json?
  summary     String?   @db.Text
  results     Json?     @db.Json
  
  // AI Provider Used
  provider    String
  model       String
  
  // Status
  status      AnalysisStatus @default(PENDING)
  error       String?        @db.Text
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

enum AnalysisMode {
  EXPLAIN
  ONBOARD
  DOCUMENT
  TEST
  REFACTOR
  PRODUCTION_READY
}

enum SourceType {
  GITHUB
  UPLOAD
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Support Ticketing System
// ============================================

model Ticket {
  id          String        @id @default(cuid())
  ticketNumber String       @unique
  
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject     String
  description String        @db.Text
  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  
  // Assignment
  assignedToEmail String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  closedAt    DateTime?
  
  // Relations
  replies     TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
  @@index([createdAt])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  message   String   @db.Text
  isStaff   Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
}

enum TicketCategory {
  TECHNICAL
  BILLING
  FEATURE_REQUEST
  BUG_REPORT
  GENERAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

// ============================================
// App Configuration
// ============================================

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}