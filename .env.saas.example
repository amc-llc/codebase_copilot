# Codebase Copilot - SaaS Mode Environment Variables
# Copy this file to .env.local and fill in your actual values

# ===========================================
# App Mode Configuration (REQUIRED)
# ===========================================
NEXT_PUBLIC_APP_MODE=saas

# ===========================================
# Database (REQUIRED - Neon PostgreSQL)
# ===========================================
# Get from: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===========================================
# NextAuth.js Authentication (REQUIRED)
# ===========================================
# Your production URL
NEXTAUTH_URL=https://your-domain.com

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# ===========================================
# Redis Cache (REQUIRED - Upstash)
# ===========================================
# Get from: https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ===========================================
# Stripe Payment Processing (REQUIRED)
# ===========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Create products and get price IDs from: https://dashboard.stripe.com/products
STRIPE_STARTER_PRICE_ID=price_1xxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_1xxxxxxxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_1xxxxxxxxxxxxx

# ===========================================
# Email Service (REQUIRED - Resend)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@cobraaisystems.com

# ===========================================
# Application Configuration (REQUIRED)
# ===========================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# ===========================================
# GitHub Integration (OPTIONAL)
# ===========================================
# For GitHub OAuth and repository access
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token

# For GitHub OAuth login
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ===========================================
# AI Provider API Keys (OPTIONAL)
# ===========================================
# Users can add their own keys in the app, but you can provide defaults
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ===========================================
# Security & Limits
# ===========================================
MAX_FILE_SIZE=10485760
MAX_TOTAL_SIZE=104857600
MAX_FILES=1000
RATE_LIMIT_RPM=60

# ===========================================
# Admin Account (REQUIRED)
# ===========================================
ADMIN_EMAIL=support@cobraaisystems.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 
# 1. Create accounts and get credentials:
#    - Neon PostgreSQL: https://neon.tech
#    - Upstash Redis: https://upstash.com
#    - Stripe: https://stripe.com
#    - Resend: https://resend.com
#
# 2. Copy this file to .env.local:
#    cp .env.saas.example .env.local
#
# 3. Fill in all REQUIRED values above
#
# 4. Deploy to Vercel:
#    - Import from GitHub
#    - Add all environment variables
#    - Deploy
#
# 5. Initialize database:
#    npx prisma migrate deploy
#    npx prisma db seed
#
# 6. Test your deployment:
#    - Visit your domain
#    - Create an account
#    - Test all features
#
# ===========================================